# ─── LLM ───────────────────────────────────────────────
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ─── ChromaDB ──────────────────────────────────────────
CHROMA_HOST=chroma
CHROMA_PORT=8000
CHROMA_COLLECTION_NIST=nist_rmf
CHROMA_COLLECTION_EUAI=eu_ai_act

# ─── MCP Server ────────────────────────────────────────
MCP_SERVER_HOST=0.0.0.0
MCP_SERVER_PORT=8001
MCP_TOP_K=10
MCP_CONTEXT_TOKEN_BUDGET=4096

# ─── Agent API ─────────────────────────────────────────
AGENT_API_HOST=0.0.0.0
AGENT_API_PORT=8002

# ─── LangSmith (Tracing) ───────────────────────────────
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=your-langsmith-api-key-here
LANGCHAIN_PROJECT=em-agentic-rag-2026
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# ─── Ingestion ─────────────────────────────────────────
NIST_PDF_URL=https://nvlpubs.nist.gov/nistpubs/ai/NIST.AI.100-1.pdf
EU_AI_ACT_URL=https://eur-lex.europa.eu/legal-content/EN/TXT/HTML/?uri=OJ:L_202401689
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
